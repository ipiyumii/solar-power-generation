# Copy to .env and fill in. .env is git-ignored; never commit real values.

NODE_ENV=development
PORT=5000

# MySQL. Connections to *.rds.amazonaws.com verify TLS against db/rds-ca-bundle.pem.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=slsea
DB_USER=slsea_app
DB_PASSWORD=

# Optional: a user with DDL rights, used only by `npm run migrate`.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# Public origin for Location headers and pagination links. No trailing slash.
PUBLIC_BASE_URL=http://localhost:5000

# HS256 signing secret, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_USER_TTL=8h
JWT_DEVICE_TTL=1h
